#!/usr/bin/env Rscript (script used to create the TMB table for subsequent plotting)

library(dplyr)

# Parameters

target_mb <- 36.510191

# Verified non-silent classes observed across all 14 PASS Funcotator MAFs
nonsilent_classes <- c(
  "Missense_Mutation",
  "Nonsense_Mutation",
  "Frame_Shift_Del",
  "Frame_Shift_Ins",
  "In_Frame_Del",
  "In_Frame_Ins",
  "Splice_Site",
  "Nonstop_Mutation",
  "START_CODON_INS",
  "START_CODON_SNP"
)

maf.files <- sort(
  list.files(
    pattern = "^[PO][1-7]\\.PASS\\.funcotated\\.maf$"
  )
)

# Count non-silent PASS mutations and calculate TMB

tmb.table <- lapply(maf.files, function(f) {
  
  model <- sub(
    "\\.PASS\\.funcotated\\.maf$",
    "",
    basename(f)
  )
  
  type <- ifelse(
    grepl("^P", model),
    "PDX",
    "PDO"
  )
  
  maf <- read.delim(
    f,
    comment.char = "#",
    stringsAsFactors = FALSE,
    check.names = FALSE
  )
  
  maf.nonsilent <- maf %>%
    filter(
      Variant_Classification %in% nonsilent_classes
    )
  
  n.mutations <- nrow(maf.nonsilent)
  
  tmb <- n.mutations / target_mb
  
  data.frame(
    Model = model,
    Type = type,
    NonSilent_PASS_Mutations = n.mutations,
    TMB_mut_per_Mb = round(tmb, 2),
    stringsAsFactors = FALSE
  )
  
}) %>%
  bind_rows()

# Order samples

desired.order <- c(
  "P1","O1",
  "P2","O2",
  "P3","O3",
  "P4","O4",
  "P5","O5",
  "P6","O6",
  "P7","O7"
)

tmb.table$Model <- factor(
  tmb.table$Model,
  levels = desired.order
)

tmb.table <- tmb.table %>%
  arrange(Model)

# Cohort-wide mutation class summary (QC)

all_class_counts <- lapply(maf.files, function(f) {
  
  maf <- read.delim(
    f,
    comment.char = "#",
    stringsAsFactors = FALSE,
    check.names = FALSE
  )
  
  maf %>%
    filter(
      Variant_Classification %in% nonsilent_classes
    ) %>%
    count(Variant_Classification)
  
}) %>%
  bind_rows() %>%
  group_by(Variant_Classification) %>%
  summarise(
    Total_Mutations = sum(n),
    .groups = "drop"
  ) %>%
  arrange(desc(Total_Mutations))

# Save

write.csv(
  tmb.table,
  "PDX_PDO_TMB_Table.csv",
  row.names = FALSE
)

write.csv(
  all_class_counts,
  "PDX_PDO_NonSilent_MutationClass_Summary.csv",
  row.names = FALSE
)
