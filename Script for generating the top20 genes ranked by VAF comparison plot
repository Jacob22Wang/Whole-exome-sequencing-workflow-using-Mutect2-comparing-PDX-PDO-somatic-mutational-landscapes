# Combined_VAF_Heatmap_Top20_Publication.R (this script was used to convert the master Top20 VAF table generated by the previous script into a heatmap displaying mutation types and associated VAFs across matched PDX-PDO pairs)

library(ggplot2)
library(dplyr)
library(patchwork)

# Load master table

master <- read.csv(
  "All_Pairs_Top20_VAF_Master_Table.csv",
  stringsAsFactors = FALSE
)

# Gene order

gene.order <- unique(master$Gene)

gene.pos <- data.frame(
  Gene = gene.order,
  x = seq_along(gene.order)
)

# Sample order

sample.order <- c(
  "P1","O1",
  "P2","O2",
  "P3","O3",
  "P4","O4",
  "P5","O5",
  "P6","O6",
  "P7","O7"
)

# Heatmap dataframe

tile.df <- bind_rows(
  
  master %>%
    transmute(
      Sample = sub("_.*", "", Pair),
      Gene,
      Mutation = as.character(PDX_Type)
    ),
  
  master %>%
    transmute(
      Sample = sub(".*_", "", Pair),
      Gene,
      Mutation = as.character(PDO_Type)
    )
  
)

# Complete matrix

full.grid <- expand.grid(
  Sample = sample.order,
  Gene = gene.order,
  stringsAsFactors = FALSE
)

tile.df <- full.grid %>%
  left_join(
    tile.df,
    by = c("Sample","Gene")
  )

tile.df$Mutation <- ifelse(
  is.na(tile.df$Mutation),
  "Absent",
  tile.df$Mutation
)

tile.df <- tile.df %>%
  left_join(
    gene.pos,
    by = "Gene"
  )

tile.df$Sample <- factor(
  tile.df$Sample,
  levels = rev(sample.order)
)

# VAF dataframe

value.df <- bind_rows(
  
  master %>%
    transmute(
      Sample = sub("_.*","",Pair),
      Gene,
      Value = sprintf("%d", round(PDX_VAF))
    ),
  
  master %>%
    transmute(
      Sample = sub(".*_","",Pair),
      Gene,
      Value = ifelse(
        is.na(PDO_VAF),
        "—",
        sprintf("%d", round(PDO_VAF))
      )
    )
  
)

value.df <- full.grid %>%
  left_join(
    value.df,
    by = c("Sample","Gene")
  )

value.df$Value <- ifelse(
  is.na(value.df$Value),
  "—",
  value.df$Value
)

value.df <- value.df %>%
  left_join(
    gene.pos,
    by = "Gene"
  )

value.df$Sample <- factor(
  value.df$Sample,
  levels = rev(sample.order)
)

# Mutation palette

mutation_cols <- c(
  "Missense_Mutation" = "#4E79A7",
  "Nonsense_Mutation" = "#E15759",
  "Frame_Shift_Del"   = "#F28E2B",
  "Frame_Shift_Ins"   = "#FFBE7D",
  "In_Frame_Del"      = "#2B2D42",
  "In_Frame_Ins"      = "#9C755F",
  "Splice_Site"       = "#805AD5",
  "Absent"            = "#FFFFFF"
)

# Main heatmap

p_main <- ggplot(
  tile.df,
  aes(
    x = x,
    y = Sample,
    fill = Mutation
  )
) +
  geom_tile(
    colour = NA
  ) +
  
  geom_text(
    data = gene.pos,
    aes(
      x = x,
      y = length(sample.order) + 0.55,
      label = Gene
    ),
    inherit.aes = FALSE,
    angle = 90,
    fontface = "italic",
    size = 6,
    hjust = 0,
    vjust = 0.5
  ) +
  
  scale_fill_manual(
    values = mutation_cols,
    drop = FALSE
  ) +
  
  scale_x_continuous(
    breaks = gene.pos$x,
    labels = NULL,
    expand = c(0,0)
  ) +
  
  scale_y_discrete(
    expand = c(0,0)
  ) +
  
  coord_cartesian(
    ylim = c(0.5, length(sample.order) + 0.5),
    clip = "off"
  ) +
  
  labs(
    x = NULL,
    y = NULL
  ) +
  
  theme_bw() +
  
  theme(
    panel.grid = element_blank(),
    
    panel.background = element_rect(
      fill = "white",
      colour = NA
    ),
    
    plot.background = element_rect(
      fill = "white",
      colour = NA
    ),
    
    axis.text.x = element_blank(),
    
    axis.ticks.x = element_blank(),
    
    axis.text.y = element_text(
      face = "bold",
      size = 26
    ),
    
    plot.margin = margin(
      t = 130,
      r = 5,
      b = 5,
      l = 5
    ),
    
    legend.position = "none"
  )

# VAF table

p_values <- ggplot(
  value.df,
  aes(
    x = x,
    y = Sample
  )
) +
  geom_tile(
    fill = "white",
    colour = "grey92",
    linewidth = 0.05
  ) +
  
  geom_text(
    aes(label = Value),
    size = 4.2,
    fontface = "bold"
  ) +
  
  scale_x_continuous(
    breaks = gene.pos$x,
    labels = NULL,
    expand = c(0,0)
  ) +
  
  scale_y_discrete(
    expand = c(0,0)
  ) +
  
  labs(
    x = NULL,
    y = NULL
  ) +
  
  theme_bw() +
  
  theme(
    panel.grid = element_blank(),
    
    panel.border = element_blank(),
    
    panel.background = element_rect(
      fill = "white",
      colour = NA
    ),
    
    axis.text.x = element_blank(),
    
    axis.ticks.x = element_blank(),
    
    axis.text.y = element_text(
      face = "bold",
      size = 22
    ),
    
    plot.margin = margin(
      t = -2,
      r = 5,
      b = 0,
      l = 5
    )
  )

# Combine

final.plot <-
  p_main /
  p_values +
  plot_layout(
    heights = c(
      3.2,
      2.0
    )
  )

# Save

ggsave(
  filename = "AllPairs_Merged_Top20_VAF_Heatmap_Publication_Final.pdf",
  plot = final.plot,
  width = 40,
  height = 12,
  bg = "white"
)

print(final.plot)

 


