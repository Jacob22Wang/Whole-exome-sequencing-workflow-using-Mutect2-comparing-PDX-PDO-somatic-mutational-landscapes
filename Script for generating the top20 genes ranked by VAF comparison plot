# Build All_Pairs_Top20_VAF_Master_Table.csv (this script combines the outputs of the previous script into a single master table)

library(maftools)
library(dplyr)

# Working directory

setwd("/DIR")

# Model pairs

pairs <- data.frame(
  PDX = paste0("P", 1:7),
  PDO = paste0("O", 1:7),
  stringsAsFactors = FALSE
)

# Container

master.table <- list()

# Loop through pairs

for(i in seq_len(nrow(pairs))) {
  
  pdx <- pairs$PDX[i]
  pdo <- pairs$PDO[i]
  
  cat("\n======================================\n")
  cat("Processing:", pdx, "vs", pdo, "\n")
  cat("======================================\n")
  
  # Read PASS MAFs
  
  pdx.maf <- read.maf(
    maf = paste0(pdx, ".PASS.funcotated.maf"),
    verbose = FALSE
  )
  
  pdo.maf <- read.maf(
    maf = paste0(pdo, ".PASS.funcotated.maf"),
    verbose = FALSE
  )
  
  pdx.df <- as.data.frame(pdx.maf@data)
  pdo.df <- as.data.frame(pdo.maf@data)
  
  # Remove variants lacking tumor_f
  
  pdx.df <- pdx.df %>%
    filter(!is.na(tumor_f))
  
  pdo.df <- pdo.df %>%
    filter(!is.na(tumor_f))
  
  # Highest-VAF mutation per gene in PDX
  
  pdx.top <- pdx.df %>%
    arrange(desc(tumor_f)) %>%
    group_by(Hugo_Symbol) %>%
    slice(1) %>%
    ungroup() %>%
    arrange(desc(tumor_f))
  
  # Top 20 genes
  
  pdx.top20 <- pdx.top %>%
    slice_head(n = 20) %>%
    mutate(
      Rank = row_number(),
      PDX_VAF = round(tumor_f * 100, 1)
    )

  # Match genes in PDO
  
  pdo.match <- pdo.df %>%
    filter(
      Hugo_Symbol %in% pdx.top20$Hugo_Symbol
    ) %>%
    arrange(desc(tumor_f)) %>%
    group_by(Hugo_Symbol) %>%
    slice(1) %>%
    ungroup() %>%
    mutate(
      PDO_VAF = round(tumor_f * 100, 1)
    )
  
  # Build pair table
  
  pair.table <- pdx.top20 %>%
    mutate(
      PDX_Type = as.character(Variant_Classification)
    ) %>%
    select(
      Rank,
      Gene = Hugo_Symbol,
      PDX_Type,
      PDX_VAF
    ) %>%
    left_join(
      pdo.match %>%
        mutate(
          PDO_Type = as.character(Variant_Classification)
        ) %>%
        select(
          Hugo_Symbol,
          PDO_Type,
          PDO_VAF
        ),
      by = c(
        "Gene" = "Hugo_Symbol"
      )
    ) %>%
    mutate(
      PDO_Type = ifelse(is.na(PDO_Type), "Absent", PDO_Type),
      Pair = paste0(pdx, "_", pdo)
    ) %>%
    select(
      Pair,
      Rank,
      Gene,
      PDX_Type,
      PDX_VAF,
      PDO_Type,
      PDO_VAF
    )

  # Save individual table
  
  write.csv(
    pair.table,
    paste0(
      pdx,
      "_",
      pdo,
      "_Top20_VAF_Table.csv"
    ),
    row.names = FALSE,
    quote = FALSE
  )
  
  # Add to master table
  
  master.table[[i]] <- pair.table

# Combine all pairs

master.table <- bind_rows(master.table)

# Save master table

write.csv(
  master.table,
  "All_Pairs_Top20_VAF_Master_Table.csv",
  row.names = FALSE,
  quote = FALSE
)

